@model dynamic
@{
    ViewData["Title"] = "Friend Profile";
}

<h2>Profile</h2>

<div class="card mb-3">
    <div class="card-body d-flex align-items-center">
        <img src="@Model.FotoPerfilUrl" class="rounded-circle me-3" alt="@Model.UserName" style="width:72px;height:72px;object-fit:cover;" />
        <div>
            <h4>@Model.Nombre @Model.Apellido</h4>
            <div class="text-muted">@Model.UserName</div>
        </div>
    </div>
</div>

@* Additional friend info and recent posts could go here *@
