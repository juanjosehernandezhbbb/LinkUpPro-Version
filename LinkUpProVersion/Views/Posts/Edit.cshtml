@model LinkUp.Core.Application.DTOs.Posts.CrearPublicacionDto
@{
    ViewData["Title"] = "Edit Post";
}

<h2>Edit Post</h2>

@await Html.PartialAsync("_AlertMessages")

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="AutorId" />
    <div class="mb-3">
        <label asp-for="Contenido" class="form-label">Content</label>
        <textarea asp-for="Contenido" class="form-control" rows="4"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="TipoContenido" class="form-label">Content Type</label>
        <select asp-for="TipoContenido" class="form-select">
            <option value="0">Text</option>
            <option value="1">Image</option>
            <option value="2">Video</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Replace Image</label>
        <input type="file" name="image" class="form-control image-preview-input" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>
