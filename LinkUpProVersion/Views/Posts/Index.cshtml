@model IReadOnlyList<LinkUp.Core.Application.DTOs.Posts.PublicacionDto>
@{
    ViewData["Title"] = "Home - Feed";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Feed</h2>
    <a class="btn btn-primary" asp-controller="Posts" asp-action="Create">New Post</a>
</div>

@await Html.PartialAsync("_AlertMessages")

<div class="list-group">
    @foreach (var p in Model)
    {
        <div class="list-group-item">
            <div class="d-flex w-100 justify-content-between">
                <h5 class="mb-1">@p.NombreAutor @p.ApellidoAutor</h5>
                <small class="text-muted">@p.CreatedAt.ToString("g")</small>
            </div>
            <p class="mb-1">@p.Contenido</p>
            @if (!string.IsNullOrEmpty(p.ImagenUrl))
            {
                <img src="@p.ImagenUrl" alt="post image" class="img-fluid rounded" style="max-width:200px;" />
            }
            <div class="mt-2">
                <a asp-controller="Posts" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                <form asp-controller="Posts" asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
            </div>
        </div>
    }
</div>
