@model LinkUpProVersion.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Crear Cuenta";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-lg">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h3 class="font-weight-light my-2">Crear nueva cuenta</h3>
                </div>
                <div class="card-body p-4">
                    @await Html.PartialAsync("_AlertMessages")

                    <form asp-action="Register" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-floating mb-3 mb-md-0">
                                    <input asp-for="Nombre" class="form-control" placeholder="Nombre" />
                                    <label asp-for="Nombre">Nombre</label>
                                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Apellido" class="form-control" placeholder="Apellido" />
                                    <label asp-for="Apellido">Apellido</label>
                                    <span asp-validation-for="Apellido" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-floating mb-3 mb-md-0">
                                    <input asp-for="UserName" class="form-control" placeholder="Nombre de usuario" />
                                    <label asp-for="UserName">Nombre de usuario</label>
                                    <span asp-validation-for="UserName" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Telefono" class="form-control" placeholder="Ej: 809-555-1234" />
                                    <label asp-for="Telefono">Teléfono (Ej: 809-555-1234)</label>
                                    <span asp-validation-for="Telefono" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Email" type="email" class="form-control" placeholder="nombre@ejemplo.com" />
                            <label asp-for="Email">Correo electrónico</label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FotoPerfil" class="form-label text-muted small ms-1">Foto de perfil</label>
                            <input asp-for="FotoPerfil" type="file" class="form-control form-control-lg" accept="image/*" />
                            <span asp-validation-for="FotoPerfil" class="text-danger small"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="input-group">
                                    <div class="form-floating flex-grow-1">
                                        <input asp-for="Password" type="password" class="form-control" id="inputRegPassword" placeholder="Contraseña" />
                                        <label asp-for="Password">Contraseña</label>
                                    </div>
                                    <button class="btn btn-outline-secondary toggle-password" type="button" tabindex="-1">👁️</button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small d-block mb-1"></span>
                                
                                <div class="progress mt-2" style="height: 5px;">
                                    <div id="strength-bar" class="progress-bar" role="progressbar" style="width: 0%;"></div>
                                </div>
                                <small id="strength-text" class="text-muted mt-1 d-block">Fortaleza: Ninguna</small>
                            </div>
                            
                            <div class="col-md-6 mt-3 mt-md-0">
                                <div class="input-group">
                                    <div class="form-floating flex-grow-1">
                                        <input asp-for="ConfirmPassword" type="password" class="form-control" id="inputConfirmPassword" placeholder="Confirmar Contraseña" />
                                        <label asp-for="ConfirmPassword">Confirmar Contraseña</label>
                                    </div>
                                    <button class="btn btn-outline-secondary toggle-password" type="button" tabindex="-1">👁️</button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small d-block"></span>
                            </div>
                        </div>

                        <div class="mt-4 mb-0 d-flex justify-content-between">
                            <a asp-action="Login" class="btn btn-light border px-4">Volver atrás</a>
                            <button type="submit" class="btn btn-dark px-5">Registrarse</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Lógica para Ver/Ocultar Contraseña
            document.querySelectorAll('.toggle-password').forEach(button => {
                button.addEventListener('click', function () {
                    const inputGroup = this.closest('.input-group');
                    const input = inputGroup.querySelector('input');
                    
                    if (input.type === 'password') {
                        input.type = 'text';
                        this.textContent = '🙈';
                    } else {
                        input.type = 'password';
                        this.textContent = '👁️';
                    }
                });
            });

            // Lógica para Fortaleza de Contraseña
            const passInput = document.getElementById('inputRegPassword');
            const bar = document.getElementById('strength-bar');
            const text = document.getElementById('strength-text');

            if (passInput) {
                passInput.addEventListener('input', function () {
                    const val = this.value;
                    let score = 0;
                    if (val.length >= 8) score++;
                    if (/[A-Z]/.test(val)) score++;
                    if (/[0-9]/.test(val)) score++;
                    if (/[^A-Za-z0-9]/.test(val)) score++;

                    if (val.length === 0) {
                        bar.style.width = '0%';
                        text.textContent = 'Fortaleza: Ninguna';
                        bar.style.backgroundColor = 'transparent';
                    } else if (score <= 1) {
                        bar.style.width = '25%';
                        bar.style.backgroundColor = '#dc3545';
                        text.textContent = 'Fortaleza: Débil';
                    } else if (score === 2) {
                        bar.style.width = '50%';
                        bar.style.backgroundColor = '#ffc107';
                        text.textContent = 'Fortaleza: Media';
                    } else if (score === 3) {
                        bar.style.width = '75%';
                        bar.style.backgroundColor = '#17a2b8';
                        text.textContent = 'Fortaleza: Fuerte';
                    } else {
                        bar.style.width = '100%';
                        bar.style.backgroundColor = '#28a745';
                        text.textContent = 'Fortaleza: Muy fuerte';
                    }
                });
            }
        });
    </script>
}