@model LinkUpProVersion.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Crear Nueva Contraseña";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 rounded-lg mt-5">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h4 class="font-weight-light my-2">Nueva Contraseña</h4>
                </div>
                <div class="card-body p-4">
                    @await Html.PartialAsync("_AlertMessages")

                    <form asp-action="ResetPassword" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Token" />
                        <input type="hidden" asp-for="UserName" />
                        
                        <div class="input-group mb-3">
                            <div class="form-floating flex-grow-1">
                                <input asp-for="NewPassword" type="password" class="form-control" id="inputRegPassword" placeholder="Nueva Contraseña" />
                                <label asp-for="NewPassword">Nueva Contraseña</label>
                            </div>
                            <button class="btn btn-outline-secondary toggle-password" type="button" tabindex="-1">👁️</button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small d-block mb-1 mt-n2"></span>
                        
                        <!-- Indicador de fortaleza -->
                        <div class="progress mt-2 mb-3" style="height: 5px;">
                            <div id="strength-bar" class="progress-bar" role="progressbar" style="width: 0%;"></div>
                        </div>
                        <small id="strength-text" class="text-muted mt-n2 mb-3 d-block">Fortaleza: Ninguna</small>

                        <div class="input-group mb-4">
                            <div class="form-floating flex-grow-1">
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirmar Contraseña" />
                                <label asp-for="ConfirmPassword">Confirmar Contraseña</label>
                            </div>
                            <button class="btn btn-outline-secondary toggle-password" type="button" tabindex="-1">👁️</button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-n3 mb-3"></span>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-dark">Restablecer Contraseña</button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center py-3 bg-light">
                    <div class="small"><a asp-action="Login">Volver al inicio de sesión</a></div>
                </div>
            </div>
        </div>
    </div>
</div>