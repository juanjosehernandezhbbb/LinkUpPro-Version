@{
    ViewData["Title"] = "Bienvenido a LinkUp";
}

<div class="container text-center mt-5">
    <h1 class="display-3">LinkUpPro</h1>
    <p class="lead">La plataforma definitiva para conectar con tus amigos.</p>
    <hr class="my-4">
    <p>¿Listo para empezar?</p>
    <div class="mt-4">
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-4">Iniciar Sesión</a>
        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary btn-lg px-4">Registrarse</a>
    </div>
</div>