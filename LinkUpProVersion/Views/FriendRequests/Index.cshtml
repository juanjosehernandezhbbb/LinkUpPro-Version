@model IReadOnlyList<LinkUp.Core.Application.DTOs.Friends.SolicitudAmistadDto>
@{
    ViewData["Title"] = "Friend Requests";
}

<h2>Solicitudes de amistad</h2>

@await Html.PartialAsync("_AlertMessages")

<div class="list-group">
    @foreach (var s in Model)
    {
        <div class="list-group-item d-flex justify-content-between align-items-center">
            <div>
                <div class="fw-bold">@s.NombreEmisor</div>
                <div class="small text-muted">@s.CreatedAt.ToString("g")</div>
            </div>
            <div>
                <form asp-action="Accept" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="solicitudId" value="@s.Id" />
                    <button type="submit" class="btn btn-sm btn-success">Aceptar</button>
                </form>
                <form asp-action="Reject" method="post" class="d-inline ms-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="solicitudId" value="@s.Id" />
                    <button type="submit" class="btn btn-sm btn-danger">Rechazar</button>
                </form>
            </div>
        </div>
    }
</div>
