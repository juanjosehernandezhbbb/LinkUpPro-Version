@model LinkUpProVersion.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<h2>My Profile</h2>

@await Html.PartialAsync("_AlertMessages")

<div class="card p-3">
    <div class="d-flex align-items-center">
        <img src="@Model.FotoPerfilUrl" class="rounded-circle me-3" alt="@Model.UserName" style="width:96px;height:96px;object-fit:cover;" />
        <div>
            <h4>@Model.Nombre @Model.Apellido</h4>
            <div class="text-muted">@Model.UserName</div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" class="btn btn-primary">Edit Profile</a>
</div>
