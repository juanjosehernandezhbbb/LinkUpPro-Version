@model (int CurrentPage, int TotalPages, string BaseUrl)
<nav aria-label="Page navigation">
    <ul class="pagination">
        @if (Model.CurrentPage > 1)
        {
            <li class="page-item"><a class="page-link" href="@($"{Model.BaseUrl}?page={Model.CurrentPage-1}")">Previous</a></li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link">Previous</span></li>
        }
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            if (i == Model.CurrentPage)
            {
                <li class="page-item active"><span class="page-link">@i</span></li>
            }
            else
            {
                <li class="page-item"><a class="page-link" href="@($"{Model.BaseUrl}?page={i}")">@i</a></li>
            }
        }
        @if (Model.CurrentPage < Model.TotalPages)
        {
            <li class="page-item"><a class="page-link" href="@($"{Model.BaseUrl}?page={Model.CurrentPage+1}")">Next</a></li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link">Next</span></li>
        }
    </ul>
</nav>
